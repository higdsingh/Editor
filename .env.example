# AI Model Configuration
AI_MODEL=local
# AI_MODEL=openai
# AI_MODEL=gemini
# AI_MODEL=claude

# API Keys (only if using online models)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# CLAUDE_API_KEY=sk-ant-...

# Optional: Custom API Endpoints
# CUSTOM_API_ENDPOINT=https://api.example.com

# Plugin Settings
CORRECTION_MODE=suggestion
GRAMMAR_STRICTNESS=standard
TONE=professional
LANGUAGE=en
DIALECT=en-US

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_CONTENT_GENERATION=true
ENABLE_SYNONYM_SUGGESTIONS=true
DEBOUNCE_DELAY=300
